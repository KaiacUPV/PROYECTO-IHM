/*
 * Modern, Clean QSS for Nautical Chart App
 * Inspired by Google Maps & Material Design
 *
 */

/* ~~~ General ~~~ */
QMainWindow {
    background-color: #F5F7FA; /* Light grey background */
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", Arial, sans-serif;
}

/* ~~~ Text & Labels ~~~ */
QLabel, QRadioButton, QCheckBox {
    color: #333333;
    font-size: 10pt;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDateEdit {
    background-color: #FFFFFF;
    border: 1px solid #DCDFE6;
    border-radius: 4px;
    padding: 6px;
    color: #333333;
    font-size: 10pt;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDateEdit:focus {
    border-color: #409EFF; /* Blue accent on focus */
}

/* ~~~ Buttons ~~~ */
QPushButton, QToolButton {
    color: #FFFFFF;
    background-color: #409EFF; /* Primary Blue */
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 10pt;
    font-weight: 500;
}

QPushButton:hover, QToolButton:hover {
    background-color: #66B1FF; /* Lighter blue on hover */
}

QPushButton:pressed, QToolButton:pressed {
    background-color: #3A8EE6; /* Darker blue on press */
}

QPushButton:disabled, QToolButton:disabled {
    background-color: #C0C4CC;
    color: #FFFFFF;
}

/* Specific buttons that should be subtle */
QToolButton[checkable="true"] {
    background-color: transparent;
    color: #606266; /* Dark grey text/icon */
    border: 1px solid transparent;
    padding: 6px;
}

QToolButton[checkable="true"]:hover {
    background-color: #ECF5FF; /* Very light blue on hover */
    color: #409EFF;
}

QToolButton[checkable="true"]:checked {
    background-color: #ECF5FF; /* Light blue for selected tool */
    color: #409EFF;
    border: 1px solid #B3D8FF;
}

/* Back buttons */
#btnBack1, #btnBack2, #btnBack3 {
    background-color: transparent;
    border: none;
    padding: 4px;
}

/* ~~~ GroupBox & Containers ~~~ */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E4E7ED;
    border-radius: 8px;
    margin-top: 10px;
    font-size: 11pt;
    font-weight: bold;
    color: #303133;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    left: 10px;
    background-color: #FFFFFF;
}

/* ~~~ StackedWidget & Pages ~~~ */
QStackedWidget > QWidget {
    background-color: #F5F7FA;
}

/* ~~~ Other Controls ~~~ */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #DCDFE6;
    border-radius: 4px;
    padding: 5px;
}

QComboBox::drop-down {
    border: none;
}

QSplitter::handle {
    background-color: #E4E7ED;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QHeaderView::section {
    background-color: #F5F7FA;
    border: none;
    padding: 4px;
    font-weight: bold;
    color: #909399;
}

QScrollBar:vertical {
    border: none;
    background: #F5F7FA;
    width: 8px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: #DCDFE6;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* ~~~ Tabs ~~~ */
QTabWidget::pane {
    border: 1px solid #E4E7ED;
    border-top: none;
    background-color: #FFFFFF;
}

QTabBar::tab {
    background-color: #F5F7FA;
    color: #606266;
    border: 1px solid #E4E7ED;
    border-bottom: none; /* Avoid double border */
    padding: 8px 20px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #ECF5FF;
    color: #409EFF;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #409EFF;
    font-weight: bold;
}

/* ~~~ Dialogs ~~~ */
QDialog {
    background-color: #F5F7FA;
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", Arial, sans-serif;
}
