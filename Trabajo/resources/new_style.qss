/*
 * Professional Modern QSS for Nautical Chart App
 * Following Gestalt Principles: Proximity, Similarity, Continuity, Closure
 */

/* ~~~ General ~~~ */
QMainWindow, QDialog, QMessageBox, QInputDialog, QFileDialog, #login, #signup, #HelpDialog {
    background-color: #f0f2f5;
    color: #1a1a1a;
    font-family: "Segoe UI", "Inter", "Roboto", sans-serif;
}

/* Ensure all pages and main containers have the correct background */
#page, #page_usuario, #page_problem, #page_estadistica, #centralwidget, #rightwidget, #leftwidget, #mapwidget,
QTabWidget::pane, QTextBrowser, QTableWidget, QHeaderView::section, QAbstractScrollArea {
    background-color: #f0f2f5;
    color: #1a1a1a;
}

QRadioButton, QCheckBox {
    color: #1a1a1a;
    background: transparent;
}

/* ~~~ Sidebars ~~~ */
#rightwidget {
    background-color: #ffffff;
    border-left: 1px solid #e0e0e0;
}

#leftwidget {
    background-color: #ffffff;
    border-right: 1px solid #e0e0e0;
}

/* ~~~ Text & Labels ~~~ */
QLabel {
    color: #1a1a1a;
    font-size: 10pt;
}

#lblUsuario {
    font-size: 14pt;
    font-weight: 600;
    color: #007bff;
}

/* ~~~ Inputs ~~~ */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDateEdit, QComboBox {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 8px;
    color: #1f2937;
    font-size: 10pt;
}

QLineEdit:focus, QComboBox:focus {
    border: 2px solid #3b82f6;
    outline: none;
}

/* ~~~ Buttons ~~~ */
QPushButton, QToolButton {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 8px 12px;
    color: #374151;
    font-weight: 500;
    min-width: 32px;
    min-height: 32px;
}

QPushButton:hover, QToolButton:hover {
    background-color: #f9fafb;
    border-color: #9ca3af;
}

QPushButton:pressed, QToolButton:pressed {
    background-color: #f3f4f6;
}

/* Primary Action Buttons */
#btnguardar, #btnCorregir, .loginButton {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    font-weight: 600;
}

#btnguardar:hover, #btnCorregir:hover, .loginButton:hover {
    background-color: #1d4ed8;
}

/* Danger/Logout Buttons */
#btnlogout {
    background-color: #fee2e2;
    color: #dc2626;
    border: 1px solid #fecaca;
}

#btnlogout:hover {
    background-color: #fecaca;
}

/* ~~~ Tables & Lists ~~~ */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f9fafb;
    gridline-color: #e5e7eb;
    border: 1px solid #d1d5db;
    border-radius: 6px;
}

QHeaderView::section {
    background-color: #f3f4f6;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #d1d5db;
    font-weight: 600;
    color: #374151;
}

/* ~~~ Tabs ~~~ */
QTabWidget::pane {
    border: 1px solid #d1d5db;
    background-color: #ffffff;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background-color: #f3f4f6;
    border: 1px solid #d1d5db;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
    color: #4b5563;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    border-bottom-color: #ffffff;
    color: #2563eb;
    font-weight: 600;
}

QTabBar::tab:hover {
    background-color: #e5e7eb;
}

/* ~~~ Help & Browsers ~~~ */
QTextBrowser {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 10px;
    color: #1f2937;
}

/* Ensure HTML content in QTextBrowser follows the theme */
QTextBrowser h1, QTextBrowser h2, QTextBrowser h3 {
    color: #111827;
}

QTextBrowser p, QTextBrowser li {
    color: #374151;
}

QKeySequenceEdit {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 5px;
}

/* ~~~ Containers ~~~ */
QGroupBox {
    font-weight: 600;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    margin-top: 1.2em;
    padding-top: 10px;
    background-color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #4b5563;
}

/* Tool Buttons (Gestalt: Similarity) */
QToolButton[checkable="true"] {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    margin: 2px;
    min-width: 64px;
    min-height: 64px;
}

QToolButton[checkable="true"]:checked {
    background-color: #eff6ff;
    border: 2px solid #3b82f6;
    color: #1d4ed8;
}

/* ~~~ GroupBoxes (Gestalt: Closure & Proximity) ~~~ */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 12px;
    color: #6b7280;
    font-size: 9pt;
    font-weight: 600;
    text-transform: uppercase;
}

/* Specific Tool Groups */
#widgetLetras, #widgetItems, #widgetItems_2 {
    border: none;
    background-color: #f8fafc;
    border-radius: 8px;
    margin: 4px;
}

/* ~~~ ScrollBars ~~~ */
QScrollBar:vertical {
    border: none;
    background: #f1f5f9;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

/* ~~~ Stacked Widget Pages ~~~ */
#page_usuario, #page_problem, #page_estadistica {
    background-color: #ffffff;
}

/* ~~~ Back Buttons ~~~ */
#btnBack1, #btnBack2, #btnBack3 {
    background-color: transparent;
    border: none;
    padding: 8px;
}

#btnBack1:hover, #btnBack2:hover, #btnBack3:hover {
    background-color: #f3f4f6;
    border-radius: 20px;
}

/* ~~~ Side Panel Expand Buttons (Arrows) ~~~ */
#btnExpandLeft, #btnExpandRight {
    background-color: #2563eb;
    color: white;
    border: none;
    font-weight: bold;
    font-size: 12pt;
    padding: 0px;
}

#btnExpandLeft {
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
}

#btnExpandRight {
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
}

#btnExpandLeft:hover, #btnExpandRight:hover {
    background-color: #1d4ed8;
}

/* ~~~ Splitter Handles ~~~ */
QSplitter::handle {
    background-color: #e2e8f0;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:hover {
    background-color: #3b82f6;
}
