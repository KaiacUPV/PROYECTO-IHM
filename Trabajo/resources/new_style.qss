/*
 * Professional Modern QSS for Nautical Chart App
 * Following Gestalt Principles: Proximity, Similarity, Continuity, Closure
 */

/* ~~~ General ~~~ */
QMainWindow, QDialog, QMessageBox, QInputDialog, QFileDialog, #login, #signup, #HelpDialog {
    background-color: #f0f2f5;
    color: #1a1a1a;
    font-family: "Segoe UI", "Inter", "Roboto", sans-serif;
}

/* Ensure all pages and main containers have the correct background */
#page, #page_usuario, #page_problem, #page_estadistica, #centralwidget, #leftwidget, #mapwidget,
QTabWidget::pane, QTextBrowser, QTableWidget, QHeaderView::section, QAbstractScrollArea {
    background-color: #f0f2f5;
    color: #1a1a1a;
}

QRadioButton, QCheckBox {
    color: #1a1a1a;
    background: transparent;
}

/* ~~~ Top Bar (Fixed) ~~~ */
#topBar {
    background-color: rgba(255, 255, 255, 0.98);
    border-bottom: 1px solid #d1d5db;
}

#topBar QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 2px;
    min-width: 34px;
    min-height: 34px;
}

#topBar QToolButton:hover {
    background-color: #f3f4f6;
    border-color: #d1d5db;
}

#topBar QToolButton:checked {
    background-color: #e0e7ff;
    border-color: #3b82f6;
    color: #2563eb;
}

/* ~~~ Sidebars (Overlay Style) ~~~ */
#leftwidget {
    background-color: rgba(255, 255, 255, 0.95);
    border-right: 2px solid #d1d5db;
}

#leftwidget:hover {
    border-right: 2px solid #3b82f6;
}

/* ~~~ Text & Labels ~~~ */
QLabel {
    color: #1a1a1a;
    font-size: 10pt;
}

#lblUsuario {
    font-size: 14pt;
    font-weight: 600;
    color: #007bff;
}

/* ~~~ Inputs ~~~ */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDateEdit, QComboBox {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 8px;
    color: #1f2937;
    font-size: 10pt;
}

QLineEdit:focus, QComboBox:focus {
    border: 2px solid #3b82f6;
    outline: none;
}

/* Specific fix for password toggle button */
#btnShowPassword, #btnShowPass1, #btnShowPass2 {
    min-width: 24px;
    min-height: 24px;
    max-width: 24px;
    max-height: 24px;
    padding: 2px;
    border: none;
    background: transparent;
}

/* ~~~ Buttons ~~~ */
QPushButton, QToolButton {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 8px 12px;
    color: #374151;
    font-weight: 500;
    min-width: 32px;
    min-height: 32px;
}

QPushButton:hover, QToolButton:hover {
    background-color: #f9fafb;
    border-color: #9ca3af;
}

QPushButton:pressed, QToolButton:pressed {
    background-color: #f3f4f6;
}

/* Primary Action Buttons */
#btnguardar, #btnCorregir, .loginButton {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    font-weight: 600;
    border-radius: 8px;
    padding: 10px 20px;
}

#btnguardar:hover, #btnCorregir:hover, .loginButton:hover {
    background-color: #1d4ed8;
}

/* Navigation & Problems (Blue Theme) */
#btnProblemas, #btnAleatorio {
    background-color: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #bfdbfe;
    border-radius: 12px; /* More rounded for navigation */
}

#btnProblemas:hover, #btnAleatorio:hover {
    background-color: #dbeafe;
    border-color: #3b82f6;
}

/* History (Indigo Theme) */
#btnEstadistica {
    background-color: #f5f3ff;
    color: #4f46e5;
    border: 1px solid #ddd6fe;
    border-radius: 12px;
}

#btnEstadistica:hover {
    background-color: #ede9fe;
    border-color: #6366f1;
}

/* Help (Amber Theme) */
#btnAyuda {
    background-color: #fffbeb;
    color: #d97706;
    border: 1px solid #fef3c7;
    border-radius: 20px; /* Circular-like for help */
}

#btnAyuda:hover {
    background-color: #fef3c7;
    border-color: #f59e0b;
}

/* Success/Login Buttons */
#btnlogin {
    background-color: #10b981;
    color: #ffffff;
    border: 1px solid #059669;
    border-radius: 8px;
}

#btnlogin:hover {
    background-color: #059669;
}

/* Danger/Logout/Clear Buttons */
#btnlogout, #btnLimpiar {
    background-color: #fee2e2;
    color: #dc2626;
    border: 1px solid #fecaca;
    border-radius: 8px;
}

#btnlogout:hover, #btnLimpiar:hover {
    background-color: #fecaca;
}

/* ~~~ Tables & Lists ~~~ */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f9fafb;
    gridline-color: #e5e7eb;
    border: 1px solid #d1d5db;
    border-radius: 6px;
}

QHeaderView::section {
    background-color: #f3f4f6;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #d1d5db;
    font-weight: 600;
    color: #374151;
}

/* ~~~ Tabs ~~~ */
QTabWidget::pane {
    border: 1px solid #d1d5db;
    background-color: #ffffff;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background-color: #f3f4f6;
    border: 1px solid #d1d5db;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
    color: #4b5563;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    border-bottom-color: #ffffff;
    color: #2563eb;
    font-weight: 600;
}

QTabBar::tab:hover {
    background-color: #e5e7eb;
}

/* ~~~ Help & Browsers ~~~ */
QTextBrowser {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 10px;
    color: #1f2937;
}

/* Ensure HTML content in QTextBrowser follows the theme */
QTextBrowser h1, QTextBrowser h2, QTextBrowser h3 {
    color: #111827;
}

QTextBrowser p, QTextBrowser li {
    color: #374151;
}

QKeySequenceEdit {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 5px;
}

/* ~~~ Containers ~~~ */
QGroupBox {
    font-weight: 600;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    margin-top: 1.2em;
    padding-top: 10px;
    background-color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #4b5563;
}

/* Tool Buttons (Gestalt: Similarity) */
QToolButton[checkable="true"] {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    margin: 2px;
    min-width: 64px;
    min-height: 64px;
    border-radius: 12px;
}

QToolButton[checkable="true"]:checked {
    background-color: #eff6ff;
    border: 2px solid #3b82f6;
    color: #1d4ed8;
}

/* Specific Tool Groups (Gestalt: Similarity by Shape/Color) */
/* Drawing Tools */
#btnPunto, #btnLinea, #btnArco, #btnTexto, #btnColor {
    border-radius: 8px;
}

/* Measurement Tools */
#btnRegla, #btnCompas, #btnTransportador {
    border-radius: 32px; /* Circular for instruments */
    background-color: #f8fafc;
}

/* View/Action Tools */
#btnZoomIn, #btnZoomOut, #btnMover, #btnBorrar {
    border-radius: 4px; /* Square for utility */
}

/* ~~~ GroupBoxes (Gestalt: Closure & Proximity) ~~~ */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 12px;
    color: #6b7280;
    font-size: 9pt;
    font-weight: 600;
    text-transform: uppercase;
}

/* ~~~ ScrollBars ~~~ */
QScrollBar:vertical {
    border: none;
    background: #f1f5f9;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

/* ~~~ Stacked Widget Pages ~~~ */
#page_usuario, #page_problem, #page_estadistica {
    background-color: #ffffff;
}

/* ~~~ Back Buttons ~~~ */
#btnBack1, #btnBack2, #btnBack3 {
    background-color: transparent;
    border: none;
    padding: 8px;
}

#btnBack1:hover, #btnBack2:hover, #btnBack3:hover {
    background-color: #f3f4f6;
    border-radius: 20px;
}

/* ~~~ Side Panel Expand Buttons (Arrows) ~~~ */
#btnExpandLeft {
    background-color: #2563eb;
    color: white;
    border: 1px solid #1d4ed8;
    font-weight: bold;
    font-size: 9pt;
    padding: 0px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left: none;
}

#btnExpandLeft:hover {
    background-color: #1d4ed8;
}

/* ~~~ Splitter Handles ~~~ */
QSplitter::handle {
    background-color: #cbd5e1;
}

QSplitter::handle:horizontal {
    width: 6px;
}

QSplitter::handle:hover {
    background-color: #3b82f6;
}
