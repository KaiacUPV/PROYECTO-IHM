/* Global Settings - Apple Dark Theme Inspired */
QMainWindow, QWidget {
    background-color: #2B2B2B; /* Lighter Dark Gray Background */
    color: #FFFFFF;
    font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    font-size: 14px;
}

/* GroupBox - Card style */
QGroupBox {
    background-color: #383838; /* Card background */
    border: 1px solid #3A3A3A;
    border-radius: 12px;
    margin-top: 1em;
    padding: 15px;
    color: #FFFFFF;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #E0E0E0;
}

/* ToolButtons (Sidebar/Toolbar) */
QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px;
    color: #E0E0E0;
    font-weight: 500;
}
QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
}
QToolButton:checked {
    background-color: rgba(0, 122, 255, 0.15); /* Apple Blue tint */
    color: #0A84FF;
    border: 1px solid rgba(0, 122, 255, 0.3);
}
QToolButton:pressed {
    background-color: rgba(255, 255, 255, 0.15);
}

/* PushButtons - Apple Style */
QPushButton {
    background-color: #3A3A3A; /* Secondary button color */
    color: #FFFFFF;
    border: 1px solid #4A4A4A;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #454545;
}
QPushButton:pressed {
    background-color: #2A2A2A;
}

/* Primary Action Button (Blue) */
QPushButton#btnguardar, QPushButton#btnlogin, QPushButton#btnCorregir {
    background-color: #007AFF; /* Apple System Blue */
    border: 1px solid #007AFF;
}
QPushButton#btnguardar:hover, QPushButton#btnlogin:hover, QPushButton#btnCorregir:hover {
    background-color: #0062CC;
}

/* Destructive Action (Red) */
QPushButton#btnlogout {
    background-color: #FF3B30; /* Apple System Red */
    border: 1px solid #FF3B30;
}
QPushButton#btnlogout:hover {
    background-color: #D70015;
}

/* Input Fields */
QLineEdit, QDateEdit, QSpinBox, QComboBox {
    background-color: #252525; /* Darker input background */
    border: 1px solid #3A3A3A;
    border-radius: 8px;
    padding: 6px 10px;
    color: #FFFFFF;
    selection-background-color: #007AFF;
}
QLineEdit:focus, QDateEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #007AFF; /* Focus ring */
}

/* ComboBox specific */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 0px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

/* TableWidget (Statistics) */
QTableWidget {
    background-color: #383838;
    alternate-background-color: #404040;
    border: 1px solid #3A3A3A;
    border-radius: 10px;
    gridline-color: #3A3A3A;
    color: #FFFFFF;
}
QTableWidget::item {
    padding: 5px;
    border-bottom: 1px solid #3A3A3A;
}
QTableWidget::item:selected {
    background-color: #007AFF;
    color: #FFFFFF;
}
QHeaderView::section {
    background-color: #2B2B2B;
    color: #E0E0E0;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #3A3A3A;
    font-weight: bold;
}

/* Scrollbars - Mac style thin */
QScrollBar:vertical {
    border: none;
    background: #2B2B2B;
    width: 12px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #555;
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #777;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Labels */
QLabel {
    color: #FFFFFF;
}
QLabel#lblUsuario {
    font-size: 16px;
    font-weight: bold;
    color: #FFFFFF;
}

/* Avatars */
QLabel#lblUserAvatar_2, QLabel#lblUserAvatar {
    border: 2px solid #555;
    background-color: #2B2B2B;
    border-radius: 50px; /* Ensure circular */
}

/* Splitter */
QSplitter::handle {
    background-color: #3A3A3A;
}

/* Specific overrides for specific widgets if needed */
QTextEdit {
    background-color: #252525;
    color: #FFFFFF;
    border: 1px solid #3A3A3A;
    border-radius: 8px;
}
