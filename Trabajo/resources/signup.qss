/* Microsoft Fluent Design Style for Signup */

QWidget {
    background-color: #FFFFFF;
    font-family: "Segoe UI", "Segoe UI Variable", "Segoe", sans-serif;
    font-size: 14px;
    color: #1A1A1A;
}

/* Labels */
QLabel {
    color: #1A1A1A;
    font-weight: 400;
}

QLabel#leName, QLabel#leEmail, QLabel#lebirth, QLabel#Password_Label, QLabel#Repeat_Label {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 4px;
}

QLabel#Title_Label {
    color: #5E5E5E;
    font-size: 12px;
    padding: 10px;
}

/* Input Fields */
QLineEdit, QDateEdit {
    background-color: #FFFFFF;
    border: 1px solid #D1D1D1;
    border-bottom: 1px solid #8A8A8A;
    border-radius: 4px;
    padding: 6px 10px;
    color: #1A1A1A;
    selection-background-color: #0067C0;
    selection-color: #FFFFFF;
    min-height: 20px;
}

QLineEdit:hover, QDateEdit:hover {
    background-color: #FDFDFD;
    border-color: #BEBEBE;
    border-bottom-color: #5E5E5E;
}

QLineEdit:focus, QDateEdit:focus {
    border: 1px solid #D1D1D1;
    border-bottom: 2px solid #0067C0;
    background-color: #FFFFFF;
}

/* Primary Button (Aceptar) */
QPushButton#Accept_Button {
    background-color: #0067C0;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 8px 24px;
    font-weight: 600;
    font-size: 14px;
}

QPushButton#Accept_Button:hover {
    background-color: #005DA6;
}

QPushButton#Accept_Button:pressed {
    background-color: #005293;
    color: rgba(255, 255, 255, 0.7);
}

/* Avatar Button */
QPushButton#Btn_Avatar {
    background-color: #F3F3F3;
    color: #1A1A1A;
    border: 1px solid #D1D1D1;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton#Btn_Avatar:hover {
    background-color: #EBEBEB;
    border-color: #BEBEBE;
}

QPushButton#Btn_Avatar:pressed {
    background-color: #E0E0E0;
}

/* Password Toggle Buttons */
QToolButton#btnShowPass1, QToolButton#btnShowPass2 {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px;
}

QToolButton#btnShowPass1:hover, QToolButton#btnShowPass2:hover {
    background-color: #F0F0F0;
}

QToolButton#btnShowPass1:pressed, QToolButton#btnShowPass2:pressed {
    background-color: #E0E0E0;
}

/* Avatar Label */
QLabel#lblUserAvatar {
    border: 2px solid #D1D1D1;
    border-radius: 40px; /* Assuming 80x80 size */
    background-color: #F3F3F3;
}
